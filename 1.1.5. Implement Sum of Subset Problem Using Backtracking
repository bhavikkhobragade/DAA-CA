#include <stdio.h>
#include <stdlib.h>

int** all_subsets = NULL;
int* subset_sizes = NULL;
int subset_count = 0;
int max_subsets_capacity = 2000;

void ensure_capacity() {
	if (subset_count >= max_subsets_capacity) {
		max_subsets_capacity *= 2;
		all_subsets = (int**)realloc(all_subsets, max_subsets_capacity * sizeof(int*));
		subset_sizes = (int*)realloc(subset_sizes, max_subsets_capacity * sizeof(int));
	}
}

void backtrack(int index, int current_sum, int target_sum, int* current_subset, int current_size, int* elements, int n) {

	if (current_sum == target_sum) {
		ensure_capacity();
		all_subsets[subset_count] = (int*)malloc(current_size * sizeof(int));
		for (int i = 0; i < current_size; i++) {
			all_subsets[subset_count][i] = current_subset[i];
		}
		subset_sizes[subset_count] = current_size;
		subset_count++;
		return;
	}

	if (index >= n || current_sum > target_sum) {
		return;
	}

	current_subset[current_size] = elements[index];
	backtrack(index + 1, current_sum + elements[index], target_sum, current_subset, current_size + 1, elements, n);

	backtrack(index + 1, current_sum, target_sum, current_subset, current_size, elements, n);
}

int main() {
	int n;
	if (scanf("%d", &n) != 1) return 0;

	int* elements = (int*)malloc(n * sizeof(int));
	for (int i = 0; i < n; ++i) {
		if (scanf("%d", &elements[i]) != 1) return 0;
	}

	int target_sum;
	if (scanf("%d", &target_sum) != 1) return 0;

	int* current_subset = (int*)malloc(n * sizeof(int));
	all_subsets = (int**)malloc(max_subsets_capacity * sizeof(int*));
	subset_sizes = (int*)malloc(max_subsets_capacity * sizeof(int));

	backtrack(0, 0, target_sum, current_subset, 0, elements, n);

	if (subset_count == 0) {
		printf("-1\n");
	} else {

		for (int i = subset_count - 1; i >= 0; --i) {
			for (int j = 0; j < subset_sizes[i]; ++j) {

				printf("%d ", all_subsets[i][j]);
			}
			printf("\n");
		}
	}

	for (int i = 0; i < subset_count; i++) {
		free(all_subsets[i]);
	}
	free(all_subsets);
	free(subset_sizes);
	free(current_subset);
	free(elements);

	return 0;
}

