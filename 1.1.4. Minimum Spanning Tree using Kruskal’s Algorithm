#include <stdio.h>
#include <stdlib.h>
#include <limits.h>



void kruskalMST(int **cost, int V) {

	// Write your code here...
 int *parent = (int *)malloc(V * sizeof(int));
    for (int i = 0; i < V; i++) {
        parent[i] = i;
    }

    int edge_count = 0;
    int min_cost = 0;
    const int INF = 9999;

    // Kruskal's algorithm requires exactly V - 1 edges for a valid MST
    while (edge_count < V - 1) {
        int min = INF;
        int u = -1, v = -1;

        // Traverse the upper triangular matrix row-wise
        // This naturally processes edge weights and tie-breakers in the required order
        for (int i = 0; i < V; i++) {
            for (int j = i + 1; j < V; j++) {
                if (cost[i][j] < min) {
                    
                    // Inlined Find operation to check root sets of i and j
                    int root_i = i;
                    while (parent[root_i] != root_i) {
                        root_i = parent[root_i];
                    }
                    
                    int root_j = j;
                    while (parent[root_j] != root_j) {
                        root_j = parent[root_j];
                    }

                    // If they belong to different components, it won't form a cycle
                    if (root_i != root_j) {
                        min = cost[i][j];
                        u = i;
                        v = j;
                    }
                }
            }
        }

        // If a valid edge with a weight less than INF is found, include it
        if (u != -1 && v != -1) {
            printf("Edge %d:(%d, %d) cost:%d\n", edge_count, u, v, min);
            min_cost += min;

            // Inlined Union operation: link components together
            int root_u = u;
            while (parent[root_u] != root_u) {
                root_u = parent[root_u];
            }
            int root_v = v;
            while (parent[root_v] != root_v) {
                root_v = parent[root_v];
            }
            parent[root_u] = root_v;

            edge_count++;
        } else {
            // Stop early if no more edges connect the remaining nodes (disconnected graph)
            break;
        }
    }

    printf("Minimum cost= %d\n", min_cost);
    
    // Free the dynamically allocated parent tracker array
    free(parent);
}


int main() {
    int V;
    printf("No of vertices: ");
    scanf("%d", &V);

    int **cost = (int **)malloc(V * sizeof(int *));
    for (int i = 0; i < V; i++)
        cost[i] = (int *)malloc(V * sizeof(int));

    printf("Adjacency matrix:\n");
    for (int i = 0; i < V; i++)
        for (int j = 0; j < V; j++)
            scanf("%d", &cost[i][j]);

    kruskalMST(cost, V);

    for (int i = 0; i < V; i++)
        free(cost[i]);
    free(cost);

    return 0;
}
