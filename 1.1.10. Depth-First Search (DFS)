// Depth-First Search (DFS) function
void DFS(int start) {
	visited[start] = 1;
	printf("%d ", start);
	Node* temp = adjList[start];
	while (temp != NULL) {
		int adjVertex = temp->vertex;
		if (!visited[adjVertex]) {
			DFS(adjVertex);
		}
		temp = temp->next;
	}


}

